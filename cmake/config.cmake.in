@PACKAGE_INIT@

# Home made search for the CppAD package.
list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}/CppAD/")

# Search of the dependencies.
include(CMakeFindDependencyMacro)
find_dependency(Boost COMPONENTS serialization REQUIRED)


# Define the @PROJECT_NAME@ target.
include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@-targets.cmake")

# Setup old *_INCLUDE_DIRS and *_LIBRARIES paths for backward compatibility.
set_and_check(@PROJECT_NAME@_INCLUDE_DIRS
              "@PACKAGE_INSTALL_PREFIX@/include")
set_and_check(
  @PROJECT_NAME@_LIBRARIES
  "@PACKAGE_INSTALL_PREFIX@/lib/lib@PROJECT_NAME@.so")
check_required_components(@PROJECT_NAME@)
